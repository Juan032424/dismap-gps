HTTP_PORT=3000
TCP_H02_PORT=5013
DATABASE_URL=postgres://postgres:cambiame@localhost:5433/dismap
REDIS_URL=redis://localhost:6379
H02_ACK_HEARTBEAT=true

# Autenticación (Fase 3)
# JWT_SECRET: cadena larga y aleatoria. GENERA UNA PROPIA en producción, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES=12h
# Super admin inicial (se crea solo si la tabla users está vacía).
# Si dejas SUPERADMIN_PASSWORD vacío, el sistema genera una contraseña
# aleatoria y la muestra UNA vez en el log de arranque.
SUPERADMIN_EMAIL=sigae@discolsas.com
SUPERADMIN_PASSWORD=pon-aqui-una-clave-inicial
