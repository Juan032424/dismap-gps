# DISMAP GPS — variables de PRODUCCIÓN.
# Copia este archivo a  .env  en el servidor y rellena valores fuertes.
#   cp .env.prod.example .env

# Contraseña de la base de datos (elige una fuerte)
POSTGRES_PASSWORD=pon-aqui-una-clave-fuerte

# Secreto para firmar los tokens de sesión (JWT). GENERA UNO ÚNICO:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pega-aqui-una-cadena-larga-y-aleatoria
JWT_EXPIRES=12h

# Super admin inicial (se crea automáticamente en el primer arranque)
SUPERADMIN_EMAIL=sigae@discolsas.com
SUPERADMIN_PASSWORD=cambia-esta-clave-inicial

# Dominio con HTTPS (Caddy pide el certificado solo la primera vez).
# El DNS del dominio debe apuntar a la IP del servidor ANTES de levantar Caddy.
DOMAIN=gps.tudominio.com
SERVER_IP=167.148.33.153

# Dirección que el panel muestra en los comandos SMS de los GPS.
# Déjala como la IP: los equipos reportan por TCP directo, no por el dominio.
PUBLIC_HOST=167.148.33.153
